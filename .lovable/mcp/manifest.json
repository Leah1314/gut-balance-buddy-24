        "name": "list_food_logs",
        "title": "List food logs",
        "description": "List the signed-in user's most recent food log entries, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "How many entries to return."
            },
            "since": {
              "type": "string",
              "description": "Optional ISO date/time; only entries created after it are returned."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_food_log",
        "title": "Add food log",
