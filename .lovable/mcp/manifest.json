        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "food_name": {
              "type": "string",
              "minLength": 1,
              "description": "Name of the meal or food item."
            },
            "description": {
              "type": "string",
              "description": "Optional notes about the meal."
            },
            "created_at": {
              "type": "string",
              "description": "Optional ISO timestamp for backdated entries."
            }
          },
          "required": [
            "food_name"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
